{
  "name": "hub-page",
  "description": "The mod is listed in the KY hub with a Settings tab (its config entries) and a Screenshots tab, and the hub opens to the Screenshots tab",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "valheimdiscordrelay.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "hook", "name": "kc.hubOpen", "args": { "mod": "com.kydldev.ValheimDiscordRelay", "tab": "screenshots" }, "expect": true },
    { "do": "wait", "seconds": 1 },
    { "do": "hook", "name": "kc.hubMods", "contains": "com.kydldev.ValheimDiscordRelay" },
    { "do": "hook", "name": "kc.hubTabs", "args": { "mod": "com.kydldev.ValheimDiscordRelay" }, "contains": "settings", "label": "Settings tab" },
    { "do": "hook", "name": "kc.hubTabs", "args": { "mod": "com.kydldev.ValheimDiscordRelay" }, "contains": "screenshots", "label": "Screenshots tab" },
    { "do": "hook", "name": "kc.hubClose" }
  ],
  "asserts": [ { "check": "noErrors", "source": "ValheimDiscordRelay" } ]
}