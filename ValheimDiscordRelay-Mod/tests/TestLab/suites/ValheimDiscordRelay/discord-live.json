{
  "name": "discord-live",
  "description": "Against a REAL Discord test webhook (environment variable VDR_TEST_WEBHOOK; without it the hooks answer ok-skipped and only the screenshots go to the suite webhooks): a chat line with a normal name, a chat line whose name Discord refuses (it must arrive under the neutral name), a clip upload under the clip sender name, and the three screenshot kinds",
  "timeout": 150,
  "steps": [
    { "do": "hook", "name": "valheimdiscordrelay.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "seconds": 8 },
    { "do": "hook", "name": "valheimdiscordrelay.liveChat", "args": { "name": "Plain Dave" }, "contains": "ok", "label": "chat line, normal name" },
    { "do": "hook", "name": "valheimdiscordrelay.liveChat", "args": { "name": "Discord Dave" }, "contains": "ok", "label": "chat line, name Discord refuses" },
    { "do": "hook", "name": "valheimdiscordrelay.liveClip", "contains": "ok", "label": "clip upload, sender ValheimRelay Clips" },
    { "do": "hook", "name": "valheimdiscordrelay.screenshot", "args": { "mode": 0 }, "expect": 1, "label": "normal screenshot" },
    { "do": "wait", "seconds": 10 },
    { "do": "hook", "name": "valheimdiscordrelay.screenshot", "args": { "mode": 1 }, "expect": 1, "label": "no-HUD screenshot" },
    { "do": "wait", "seconds": 10 },
    { "do": "hook", "name": "valheimdiscordrelay.screenshot", "args": { "mode": 2 }, "expect": 1, "label": "no-HUD-no-player screenshot" },
    { "do": "wait", "seconds": 10 }
  ],
  "asserts": [ { "check": "noErrors", "source": "ValheimDiscordRelay" } ]
}