{
  "name": "startup-clean",
  "description": "The mod's own InGameTests pass in a TestLab world, the one config file is bound with every entry, the mod is enabled by default and nothing logged an error",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "valheimdiscordrelay.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "seconds": 6 },
    { "do": "hook", "name": "valheimdiscordrelay.selftest", "contains": "PASS", "notContains": "FAIL", "label": "InGameTests" },
    { "do": "hook", "name": "valheimdiscordrelay.configEntries", "min": 60 },
    { "do": "hook", "name": "valheimdiscordrelay.enabled", "min": 1 }
  ],
  "asserts": [ { "check": "noErrors", "source": "ValheimDiscordRelay" } ]
}
