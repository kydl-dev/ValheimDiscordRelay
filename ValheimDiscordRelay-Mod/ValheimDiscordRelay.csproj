<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ValheimDiscordRelay mod. Everything shared by the user's mods (references from the shared reference folder, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, deploy to the Gale test profile) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod.
    Build: dotnet build "ValheimDiscordRelay-Mod\ValheimDiscordRelay.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>ValheimDiscordRelay</AssemblyName>
    <RootNamespace>ValheimDiscordRelay</RootNamespace>
    <PackageId>ValheimDiscordRelay</PackageId>
    <!-- 2.0.0: one plugin; the KY hub (F6, the Settings tab with every config entry) and the shared log come from KydlCore (a hard dependency) -->
    <KydlUseCore>true</KydlUseCore>
    <!-- no AssetBundle: this mod ships code only (BundleName empty = Kydl.Mod.targets embeds and copies no bundle) -->
    <!-- spec layout (MIGRATION_DECISIONS A8): the DLL goes to assets\ only, no build\ folder -->
    <KydlBuildFolder>false</KydlBuildFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests\ (NUnit + TestLab suites), docs\ and release\ live inside this folder but are never part of the mod (spec 3: excluded from the release) -->
    <Compile Remove="tests\**;docs\**;release\**" />
    <None Remove="tests\**;docs\**;release\**" />
    <EmbeddedResource Remove="tests\**;docs\**;release\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- special to this mod (screenshots and video clips); the DLLs are in Claude\ref -->
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ValheimRefs)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ValheimRefs)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    img2webp.exe + its DLLs (libwebp), embedded and unpacked at run time by Client\WebP*.cs. They are git-ignored (no *.dll / *.exe in git), so the BUILD fetches them
    when they are missing: WebP\prepare-webp.ps1 downloads the official libwebp zip (checks its SHA-256) into WebP\EmbeddedWebP. This is the only network access of a build,
    and only on the first build (or after the folder was deleted). A failed download FAILS the build: a DLL without the tools would silently have no clip support.
    Skip it with  -p:KydlSkipWebP=true  (the mod then builds without clip support, e.g. on a machine without internet).
    The embedded items are added inside the target, after the download, so the very first build already contains the files.
  -->
  <Target Name="PrepareWebP" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <WebPFolder>$(MSBuildProjectDirectory)\WebP\EmbeddedWebP</WebPFolder>
    </PropertyGroup>
    <Message Condition="'$(KydlSkipWebP)' != 'true' And !Exists('$(WebPFolder)\img2webp.exe')" Importance="high" Text="ValheimDiscordRelay: img2webp.exe is missing - downloading the official libwebp (needs internet; -p:KydlSkipWebP=true skips this)." />
    <Exec Condition="'$(KydlSkipWebP)' != 'true' And !Exists('$(WebPFolder)\img2webp.exe')" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\WebP\prepare-webp.ps1&quot;" IgnoreExitCode="true" />
    <Error Condition="'$(KydlSkipWebP)' != 'true' And !Exists('$(WebPFolder)\img2webp.exe')" Text="ValheimDiscordRelay: WebP\EmbeddedWebP\img2webp.exe is missing and could not be downloaded. Check the internet connection and run WebP\prepare-webp.ps1 by hand, or build with -p:KydlSkipWebP=true (no clip support)." />
    <ItemGroup Condition="Exists('$(WebPFolder)')">
      <WebPTool Include="$(WebPFolder)\*.*" />
      <EmbeddedResource Include="@(WebPTool)" LogicalName="ValheimDiscordRelay.EmbeddedWebP.%(WebPTool.Filename)%(WebPTool.Extension)" />
    </ItemGroup>
  </Target>
  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>
