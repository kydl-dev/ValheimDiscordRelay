{
  "name": "screenshot-kinds",
  "description": "Webhook per kind (own webhook, else the global one) and the player's switches: a kind switched off has no F6 button, its request is refused, and the other two are not affected",
  "timeout": 60,
  "steps": [
    { "do": "wait", "seconds": 6 },
    { "do": "hook", "name": "ValheimDiscordRelay.webhookFor", "args": { "mode": 0 }, "contains": "/screenshot", "label": "normal -> global" },
    { "do": "hook", "name": "ValheimDiscordRelay.webhookFor", "args": { "mode": 1 }, "contains": "/screenshot", "notContains": "/noplayer", "label": "no HUD, own webhook empty -> global" },
    { "do": "hook", "name": "ValheimDiscordRelay.webhookFor", "args": { "mode": 2 }, "contains": "/noplayer", "label": "no HUD no player -> own webhook" },
    { "do": "hook", "name": "ValheimDiscordRelay.hubButtons", "expect": 3, "label": "three buttons" },

    { "do": "hook", "name": "ValheimDiscordRelay.setKindEnabled", "args": { "mode": 1, "on": 0 }, "expect": 0 },
    { "do": "hook", "name": "ValheimDiscordRelay.kindActive", "args": { "mode": 1 }, "expect": 0 },
    { "do": "hook", "name": "ValheimDiscordRelay.kindActive", "args": { "mode": 0 }, "expect": 1, "label": "normal unaffected" },
    { "do": "hook", "name": "ValheimDiscordRelay.kindActive", "args": { "mode": 2 }, "expect": 1, "label": "no HUD no player unaffected" },
    { "do": "hook", "name": "ValheimDiscordRelay.hubButtons", "expect": 2, "label": "no-HUD button gone" },
    { "do": "hook", "name": "ValheimDiscordRelay.screenshot", "args": { "mode": 1 }, "expect": 0, "label": "no-HUD request refused" },
    { "do": "hook", "name": "ValheimDiscordRelay.setKindEnabled", "args": { "mode": 1, "on": 1 }, "expect": 1 },

    { "do": "hook", "name": "ValheimDiscordRelay.setKindEnabled", "args": { "mode": 0, "on": 0 }, "expect": 0 },
    { "do": "hook", "name": "ValheimDiscordRelay.hubButtons", "expect": 2, "label": "normal button gone" },
    { "do": "hook", "name": "ValheimDiscordRelay.screenshot", "args": { "mode": 0 }, "expect": 0, "label": "normal request refused" },
    { "do": "hook", "name": "ValheimDiscordRelay.setKindEnabled", "args": { "mode": 0, "on": 1 }, "expect": 1 },

    { "do": "hook", "name": "ValheimDiscordRelay.setKindEnabled", "args": { "mode": 2, "on": 0 }, "expect": 0 },
    { "do": "hook", "name": "ValheimDiscordRelay.hubButtons", "expect": 2, "label": "no-HUD-no-player button gone" },
    { "do": "hook", "name": "ValheimDiscordRelay.screenshot", "args": { "mode": 2 }, "expect": 0, "label": "no-HUD-no-player request refused" },
    { "do": "hook", "name": "ValheimDiscordRelay.setKindEnabled", "args": { "mode": 2, "on": 1 }, "expect": 1 },

    { "do": "hook", "name": "ValheimDiscordRelay.hubButtons", "expect": 3, "label": "all three back" }
  ],
  "asserts": [ { "check": "noErrors", "source": "ValheimDiscordRelay" } ]
}